#!/bin/sh
# Mount the pseudo-filesystems on the temporary root, mount the root
# filesystem the kernel command line names, and hand the machine over.
#
# This runs as pid 1 on a ramfs, with the archive the kernel unpacked as its
# whole world. Everything it does before `switch_root` is gone with that
# ramfs, and everything it mounts *onto the new root* is not.

export PATH=/sbin:/usr/sbin:/bin:/usr/bin

# Before the command line is read, because /proc/cmdline is where it is read
# from, and before anything else because every tool below wants one of these
# three.
mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev

root=''
# The command line says which filesystem the root device carries
# (`rootfstype=`); ext4 is the fallback because the kernel routes ext2, ext3
# and ext4 to the same driver and the name costs nothing.
rootfstype='ext4'
rootflags='rw'
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        root=*)      root="${arg#root=}" ;;
        rootfstype=*) rootfstype="${arg#rootfstype=}" ;;
        rootflags=*) rootflags="${arg#rootflags=}" ;;
    esac
done

if [ -z "$root" ]; then
    echo "initramfs: no root= on the command line; staying here"
    exec /bin/sh
fi

mkdir -p /sysroot
if ! mount -t "$rootfstype" -o "$rootflags" "$root" /sysroot; then
    echo "initramfs: cannot mount $root; staying here"
    exec /bin/sh
fi

# The directories the real init expects to find already mounted. What is
# mounted here survives the pivot; what is created here does not, so each one
# is made on the new root, not on the ramfs.
for dir in proc sys dev tmp run; do
    mkdir -p "/sysroot/$dir"
done

mount -t proc     proc     /sysroot/proc
mount -t sysfs    sysfs    /sysroot/sys
mount -t tmpfs    tmpfs    /sysroot/tmp
mount -t tmpfs    tmpfs    /sysroot/run
mount --move /dev /sysroot/dev

# devpts is a filesystem of its own, not a directory devtmpfs hands out: the
# kernel's devfs carries the empty /dev/pts mountpoint, and until devpts sits
# on it, every openpty - sudo's "unable to allocate pty", a nested ssh - dies
# opening /dev/pts/<n> with ENOENT. The selftest image has mounted this from
# the start; the real one somehow never did.
mount -t devpts devpts /sysroot/dev/pts

# The host share, mounted *again* on the tree that becomes `/`. The kernel's
# own mount of it (`steps::mount_share`) hangs on the bootstrap root's `/mnt`,
# and this switch deletes that root - so a payload running under the switched
# tree would find `/mnt/share` an ordinary empty directory. (It is not merely a
# name the walk cannot reach: the disk mounted over `/mnt` *covers* it, which is
# what happens to any mount a later one is hung in front of.) Mounting it again
# is the same rule the pseudo-filesystems above follow - what is mounted on the
# new root survives the pivot.
#
# No tag is written here. The host chooses the tag (`-virtfs
# ...,mount_tag=...`), and an empty source is this kernel's spelling for "the
# share the bus exported" - the same call `steps::mount_share` makes, without
# this script keeping a second copy of the host's choice. A boot with no share
# has nothing to mount and says so rather than failing.
mkdir -p /sysroot/mnt/share
mount -t 9p '' /sysroot/mnt/share || echo "initramfs: no host share to re-mount"

exec switch_root /sysroot /sbin/init

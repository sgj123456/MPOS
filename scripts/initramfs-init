#!/bin/sh
# The initramfs's /init: the machine's first userland.
#
# The kernel unpacks the initramfs as its root and runs this file as pid 1.
# Everything the kernel no longer does itself happens here: mounting the
# canonical directories on the temporary root, mounting the real root
# filesystem, and handing the machine over. It is a `switch_root` and not a
# `pivot_root` because the root the kernel gave us is rootfs - a ramfs, which
# cannot be unmounted or moved out of - and emptying it is the only way to
# give its memory back.
set -e

echo "init: mounting the canonical directories"
# The early environment. The kernel mounted nothing: these are here because
# this script mounted them. /dev may already be there - the kernel's own
# conformance checks mount a devfs while they run - and that one is the same
# device set, so a busy answer is not a failure.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devfs devfs /dev 2>/dev/null || true

echo "init: mounting the real root"
# The real root, by the device name the kernel's devfs publishes for the
# rootfs partition of the boot disk.
mount -t ext2 /dev/vda3 /new_root

echo "init: handing over"

# Clean up initramfs artifacts before switching. switch_root should empty the
# old root, but BusyBox's implementation may leave files behind. Remove known
# artifacts so they do not appear in the new root's top level.
rm -f /init /init.mkinitfs 2>/dev/null || true
rm -rf /newroot 2>/dev/null || true

# Hand the machine over. switch_root empties this root, chroots into the new
# one and execs the given init as pid 1; OpenRC mounts /proc, /sys, /dev and
# /run on the real root and starts the services from there.
exec switch_root /new_root /sbin/init

#!/bin/sh
# The second machine's early-userspace `/init`: mount the pseudo-filesystems,
# mount the root the kernel command line names, and hand the machine over.
#
# This is the same script the x86_64 machine runs as its initramfs `/init`, and
# it exists on this machine for the same reason (`NOTES.md` §15.6): a kernel that
# assembles the real root first leaves pieces the owner of the system cannot
# unmount, so the switch belongs to pid 1 - on both machines. What differs is
# the one line it prints: `MPOS_SWITCH_ROOT_OK` says which device became `/`,
# where the first machine's script prints nothing at all. The pivot moved from
# the kernel into this script, so the line is the evidence that a userspace
# program - not the kernel - did the switch (`NOTES.md` §15.7).

export PATH=/sbin:/usr/sbin:/bin:/usr/bin

# Before the command line is read, because /proc/cmdline is where it is read
# from, and before anything else because every tool below wants one of these
# three.
mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev

root=''
# The command line says which filesystem the root device carries
# (`rootfstype=`); ext4 is the fallback because the kernel routes ext2, ext3
# and ext4 to the same driver and the name costs nothing.
rootfstype='ext4'
rootflags='rw'
# Whether this is a test boot. The kernel reads the same word to decide whether
# it may queue a console line before the handoff, so the two halves of that
# instrument agree by reading one source rather than by remembering a flag.
selftest=''
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        root=*)        root="${arg#root=}" ;;
        rootfstype=*)  rootfstype="${arg#rootfstype=}" ;;
        rootflags=*)   rootflags="${arg#rootflags=}" ;;
        mpos.selftest) selftest=1 ;;
    esac
done

# A real console line reaches a userspace program through the whole chain: the
# kernel queues "echo-test\n" on the console tty before it hands the machine to
# this script (an instrument `mpos.selftest` boots carry and a real userland
# must never see), and reading it back echoes it - proof that a scheduler-run
# EL0 process read console input and wrote the bytes it read, through
# `syscall::dispatch`, on the ramfs root, before the pivot. The verdict command
# pins the prefixed form; the tty's own canonical echo shows the same bytes
# without it.
#
# Three details are measured, not assumed. *stdin*, not `/dev/console`: this
# kernel's `/dev/console` is a write-only character device whose `read` answers
# end of input, so a read of it returns nothing at all, while fd 0 is the
# console tty the line was queued on. `read`, not `cat`: a tty that has
# delivered its one queued line blocks the next read for ever, and `cat` loops
# until end of input - so `cat` would hang the pivot, where `read` returns the
# moment the line ends. And the whole block is gated on `mpos.selftest`,
# because that is what gates the kernel's injection: an Alpine boot carries no
# such word, queues nothing, and would otherwise sit here waiting for a line
# nobody owes it.
if [ -n "$selftest" ]; then
    read line
    echo "R:$line"
fi

if [ -z "$root" ]; then
    echo "initramfs: no root= on the command line; staying here"
    exec /bin/sh
fi

mkdir -p /sysroot
if ! mount -t "$rootfstype" -o "$rootflags" "$root" /sysroot; then
    echo "MPOS_SWITCH_ROOT_FAILED: cannot mount $root"
    exec /bin/sh
fi

# The directories the real init expects to find already mounted. What is
# mounted here survives the pivot; what is created here does not, so each one
# is made on the new root, not on the ramfs.
for dir in proc sys dev tmp run; do
    mkdir -p "/sysroot/$dir"
done

mount -t proc     proc     /sysroot/proc
mount -t sysfs    sysfs    /sysroot/sys
mount -t tmpfs    tmpfs    /sysroot/tmp
mount -t tmpfs    tmpfs    /sysroot/run
mount --move /dev /sysroot/dev

# devpts is a filesystem of its own, not a directory devtmpfs hands out: the
# kernel's devfs carries the empty /dev/pts mountpoint, and until devpts sits
# on it, every openpty - sudo's "unable to allocate pty", a nested ssh - dies
# opening /dev/pts/<n> with ENOENT.
mount -t devpts devpts /sysroot/dev/pts

# The host share, mounted *again* on the tree that becomes `/`. The kernel's
# own mount of it (`steps::mount_share`) hangs on the bootstrap root's `/mnt`,
# and this switch deletes that root - so a payload running under the switched
# tree would find `/mnt/share` an ordinary empty directory. (It is not merely a
# name the walk cannot reach: the disk mounted over `/mnt` *covers* it, which is
# what happens to any mount a later one is hung in front of.) Mounting it again
# is the same rule the pseudo-filesystems above follow - what is mounted on the
# new root survives the pivot.
#
# No tag is written here. The host chooses the tag (`-virtfs
# ...,mount_tag=...`), and an empty source is this kernel's spelling for "the
# share the bus exported" - the same call `steps::mount_share` makes, without
# this script keeping a second copy of the host's choice. A boot with no share
# has nothing to mount and says so rather than failing.
mkdir -p /sysroot/mnt/share
mount -t 9p '' /sysroot/mnt/share || echo "initramfs: no host share to re-mount"

# The verdict line, *before* the exec: `switch_root` deletes the ramfs it stood
# in, and with it any chance of printing after the promotion. Its presence on
# the wire means the disk answered `mount`, the move-targets exist, and the
# exec was attempted; the boot's later lines are the proof the promotion served
# a tree rather than an empty directory - the Alpine disk's `/init` makes the
# applet farm and busybox init prints `login:`, and the test disk's `/init`
# execs the payload whose markers (`MPOS_EXEC_OK`, `MPOS_MUSL_OK`) follow.
echo "MPOS_SWITCH_ROOT_OK: / is $root ($rootfstype)"

# The handoff runs an init with an *empty environment*, so PATH above is set by
# this script - but busybox's `switch_root` refuses to continue unless the
# environment still names it ("PATH must be set"), and deletes the old root
# through `/oldroot`, which has to exist as a directory on the new tree. Both
# are one line each and neither is decoration: without them the pivot dies at
# its own first check and the boot reads as a hang.
export PATH
mkdir -p /sysroot/oldroot
# `/init`, not `/sbin/init`: the name a *disk* carries is its own pid-1 chain,
# and on this machine that chain is not optional. `apk` installs cross-arch with
# `--no-scripts`, so busybox's post-install never runs and the applet farm
# (`/sbin/init`, `/bin/mount`, ...) does not exist yet - it is the disk's `/init`
# that makes it, on the one machine that can exec this busybox. Pointing
# `switch_root` at `/sbin/init` skips that step and dies here: measured as
# `switch_root: can't execute '/sbin/init': No such file or directory`, with the
# boot reading as `INIT_EXITED` and every `/t-*` program never running. Both
# boots name this path - the Alpine tree's farm-and-mounts script and the test
# payload's runner - which is what makes one target serve both.
exec switch_root /sysroot /init

# The vocabulary this script execs, as a comment the build can read. Editing a
# command line below without its verb here fails `cargo test -p mpos-xtask`
# (aarch64_initramfs's farm pin), because a name missing from the applet farm is
# a boot that dies on ENOENT mid-pivot - and a headless verdict reads that as a
# hang. One list, two readers: the shell ignores these lines, the test does not.
@vocabulary: sh mount cat echo mkdir switch_root

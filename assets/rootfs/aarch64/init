#!/bin/sh
#
# The second machine's `/init`: the first program its kernel runs after it
# switches `/` onto the disk. It does the two things that would otherwise be
# done for it - the post-install steps a *cross-architecture* `apk` could not
# run, and the mounts a real init expects to find already in place - and then
# hands the machine to Alpine's own `/sbin/init`.
#
# Why the kernel does not do the mounts itself: mounting `/proc` and `/sys` is
# userspace's job (AGENTS.md §4 rule 1), which is why the x86_64 machine does it
# from its initramfs's script. That machine has an initramfs to hold the script;
# this one pivots in the kernel, so the script lives on the disk and the kernel
# runs it exactly as it runs the test boots' `/init`.

# The applet farm. A cross-arch `apk` cannot run a package's post-install script
# - it is the *target's* binary and the host cannot exec it - so the symlinks
# `busybox --install -s` would have made (`/sbin/init`, `/bin/mount`, ...) are
# made here, on the one machine that can run this busybox. Without this there is
# no `/sbin/init` at all: the package ships the applet, not the name.
#
# Two details are load-bearing and both were measured, not assumed: the *absolute*
# path, because `busybox --install` refuses a name it cannot resolve to a
# directory to install into (`busybox: 'busybox' is not an absolute path`), and
# `PATH` set *before* the install, because the handoff runs an init with an empty
# environment - so without it the shell finds neither the applets it is about to
# create nor the `mount` it needs next. The same `PATH` the x86_64 initramfs's
# script exports, for the same reason.
export PATH=/sbin:/usr/sbin:/bin:/usr/bin
/bin/busybox --install -s

# The pseudo-filesystems a real init reads. `/dev` is already the kernel's devfs
# (the root switch mounted it); these are the ones the x86_64 initramfs mounts
# on its new root before handing over, and the reason each is needed is the same
# on both machines:
#   /proc  - openrc, busybox and every `/proc/<pid>` reader
#   /sys   - udev's and openrc's sysfs service, and `/sys/class/tty`
#   /tmp   - a writable scratch a package install or a session expects
#   /run   - where openrc puts its state and its pid files
#   devpts - `/dev/pts`, without which every openpty fails with ENOENT
mount -t proc  proc  /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts

exec /sbin/init

#!/bin/busybox sh
# The measurement guest's whole userspace: bring up the pseudo-filesystems,
# load the one driver under test, run the instrument, and stop. Everything the
# Alpine initramfs would have done - finding boot media, fetching an apkovl,
# deciding a root - is beside the point here, and each of those steps is a
# place this boot could fail for a reason that is not the virtio-gpu driver.

/bin/busybox --install -s

mount -t proc     proc /proc
mount -t sysfs    sys /sys
mount -t devtmpfs dev  /dev 2>/dev/null
mkdir -p /dev/dri

echo "=== kernel: $(cat /proc/version) ==="
echo "=== modprobe virtio_gpu ==="
modprobe virtio_gpu
sleep 1

echo "=== /sys/class/drm ==="
ls /sys/class/drm 2>/dev/null || echo "(none)"
echo "=== /dev/dri ==="
ls -l /dev/dri 2>/dev/null || echo "(none)"

echo "=== what the driver negotiated ==="
dmesg | grep -iE "virtio.?gpu|\[drm\]|virgl|cap set" | head -30

if [ -e /dev/dri/renderD128 ]; then
    /probe /dev/dri/renderD128
else
    echo "!!! no /dev/dri/renderD128 - trying card0"
    [ -e /dev/dri/card0 ] && /probe /dev/dri/card0
fi

echo "=== measurement guest done ==="
poweroff -f
